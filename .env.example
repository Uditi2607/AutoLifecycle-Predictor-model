# AutoLifecycle Predictor — Environment Variables Example
# Copy this file to .env and provide your actual secrets.
# NEVER commit the real .env file to version control.

# ── Django Core ──────────────────────────────────────────────────────────
# REQUIRED: Generate a strong, unique secret key (e.g., using `python -c "import secrets; print(secrets.token_urlsafe(50))"`)
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Set DEBUG=False for production deployments. Defaults to False if omitted.
DEBUG=False

# Comma-separated list of valid host/domain names that this Django site can serve
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Production HTTPS & Security (Active when DEBUG=False) ───────────────
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# ── Database ─────────────────────────────────────────────────────────────
# Default is SQLite (db.sqlite3).
# DATABASE_URL=sqlite:///db.sqlite3
